<UserControl x:Class="ControleCaixa.UI.Components.CaixaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="150">

    <Border
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="10"
        Padding="16">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="#22C55E"/>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">

                    <Button
                        Width="28"
                        Height="28"
                        Margin="0,0,5,0"
                        Content="✎"
                        ToolTip="Editar caixa"
                        Cursor="Hand"
                        Background="DodgerBlue"
                        Command="{Binding DataContext.EditarCaixaCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>

                    <Button
                        Width="28"
                        Height="28"
                        Content="✕"
                        ToolTip="Remover caixa"
                        Cursor="Hand"
                        Background="Red"
                        Command="{Binding DataContext.RemoverCaixaCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>

                </StackPanel>

            </Grid>

            <!-- Área clicável para abrir -->
            <Button
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Left"
                Cursor="Hand"
                Command="{Binding DataContext.AbrirCaixaCommand,
                          RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">

                <StackPanel>

                    <TextBlock
                        Text="{Binding Nome}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Margin="0,12,0,0"
                        Text="{Binding SaldoMinimo,
                                       StringFormat=Saldo mínimo: {0:C2}}"
                        FontSize="14"
                        Foreground="#15803D"/>

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>