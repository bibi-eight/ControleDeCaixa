<Window x:Class="ControleCaixa.UI.Views.CaixaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Caixa"
        Width="450"
        Height="300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nome -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Nome"/>

            <TextBox
                Height="30"
                Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Saldo mínimo -->
        <StackPanel
            
            Grid.Row="1"
            Margin="0,15,0,0">
            <TextBlock Text="Saldo Mínimo"/>

            <TextBox
                Height="30"
                Text="{Binding SaldoMinimo}" />

        </StackPanel>

        <!-- Botão -->
        <Button
            Grid.Row="2"
            Height="35"
            Margin="0,20,0,0"
            Content="Cadastrar"
            Command="{Binding CadastrarCommand}" />

        <!-- Resultado -->
        <TextBlock
            Grid.Row="3"
            Margin="0,15,0,0"
            Text="{Binding Mensagem}"
            TextWrapping="Wrap"/>

    </Grid>

</Window>