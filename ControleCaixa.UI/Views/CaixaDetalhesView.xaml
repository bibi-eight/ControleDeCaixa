<Window x:Class="ControleCaixa.UI.Views.CaixaDetalhesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do caixa"
        Width="850"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="{Binding Nome}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#111827"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Visão geral e movimentações do caixa"
                    FontSize="14"
                    Foreground="#6B7280"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                Width="100"
                Height="38"
                Content="Voltar"
                Background="White"
                BorderBrush="#D1D5DB"
                Foreground="#374151"
                Cursor="Hand"
                Click="Voltar_Click"/>
        </Grid>

        <!-- Cards financeiros -->
        <Grid Grid.Row="1" Margin="0,30,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Saldo atual -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">

                <StackPanel>
                    <TextBlock
                        Text="Saldo atual"
                        FontSize="14"
                        Foreground="#6B7280"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding Saldo, StringFormat={}{0:C2}}"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#15803D"/>
                </StackPanel>
            </Border>

            <!-- Saldo mínimo -->
            <Border
                Grid.Column="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">

                <StackPanel>
                    <TextBlock
                        Text="Saldo mínimo"
                        FontSize="14"
                        Foreground="#6B7280"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding SaldoMinimo, StringFormat={}{0:C2}}"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#D97706"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ações -->
        <Grid Grid.Row="2" Margin="0,25,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="Movimentações"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#111827"/>

            <Button
                Grid.Column="1"
                Width="140"
                Height="42"
                Content="+ Nova entrada"
                Background="#16A34A"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Command="{Binding NovaEntradaCommand}"/>

            <Button
                Grid.Column="3"
                Width="140"
                Height="42"
                Content="- Nova saída"
                Background="#DC2626"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Command="{Binding NovaSaidaCommand}"/>
        </Grid>

        <!-- Lista de movimentações -->
        <Border
            Grid.Row="3"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12"
            Padding="15">

            <Grid>

                <ListView
                    ItemsSource="{Binding Movimentacoes}"
                    BorderThickness="0"
                    Background="Transparent">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="12"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Descricao}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#111827"/>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Text="{Binding Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                            FontSize="13"
                                            Foreground="#6B7280"/>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right">

                                        <TextBlock
                                            Text="{Binding Valor, StringFormat={}{0:C2}}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#111827"/>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Text="{Binding Tipo}"
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            Foreground="#6B7280"/>
                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Mensagem para lista vazia -->
                <TextBlock
                    Text="Nenhuma movimentação registrada."
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#9CA3AF"
                    IsHitTestVisible="False">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Movimentacoes.Count}"
                                    Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>
        </Border>

    </Grid>
</Window>